<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_discount_view_tree" model="ir.ui.view">
        <field name="name">account.discount.view.tree</field>
        <field name="model">account.discount</field>
        <field name="arch" type="xml">
            <tree string="Discounts" editable="bottom">
                <field name="customer_type"/>
                <field name="percentage"/>
            </tree>
        </field>
    </record>

    <record id="account_discount_action" model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">account.discount</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
