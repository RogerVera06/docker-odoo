<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_account_discounts_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.account.discounts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="customer_type_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

</odoo>