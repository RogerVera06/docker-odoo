<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Creacion de tipos de cliente predeterminados -->
        <record id="customer_vip" model="account.discount">
            <field name="customer_type">Cliente VIP</field>
            <field name="percentage">15</field>
        </record>

        <record id="customer_retail" model="account.discount">
            <field name="customer_type">Cliente Minorista</field>
            <field name="percentage">5</field>
        </record>

        <record id="customer_wholesale" model="account.discount">
            <field name="customer_type">Cliente Mayorista</field>
            <field name="percentage">25</field>
        </record>
    </data>
</odoo>
