<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_inherit_view_form" model="ir.ui.view">
        <field name="name">hr.employee.inherit.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Performance Reviews" name="hr_performance_reviews">
                    <field name="performance_review_ids" context="{'from_employee_form': True}">
                        <tree>
                            <field name="review_date"/>
                            <field name="reviewer_id"/>
                            <field name="score"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>
