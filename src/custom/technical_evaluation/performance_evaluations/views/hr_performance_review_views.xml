<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_performance_review_view_form" model="ir.ui.view">
        <field name="name">hr.performance.review.view.form</field>
        <field name="model">hr.performance.review</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button string="Complete Review" name="action_complete_review" type="object" class="oe_highlight" invisible="status != 'pending'"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id" invisible="context.get('from_employee_form', False)" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="review_date" readonly='1'/>
                        <field name="reviewer_id" domain="[('id', '!=', employee_id)]" readonly="status != 'pending'" options="{'no_create': True, 'no_open': True}"/>
                        <field name="score" readonly="status != 'pending'"/>
                    </group>
                    <group col="2">
                        <group string="Performance Feedback" col="2">
                            <field name="comments" readonly="status != 'pending'"/>
                            <field name="goals_next_period" readonly="status != 'pending'"/>
                        </group>
                        <group string="Aspects to consider" col="2">
                            <field name="strengths" readonly="status != 'pending'"/>
                            <field name="weaknesses" readonly="status != 'pending'"/>
                        </group>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="hr_performance_review_view_kanban" model="ir.ui.view">
        <field name="name">hr.performance.review.view.kanban</field>
        <field name="model">hr.performance.review</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small" create="0">
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <field name="review_date"/>
                <field name="score"/>
                <field name="status"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div>
                                <strong><field name="employee_id"/></strong>
                            </div>
                            <div>
                                <field name="review_date"/>
                                <field name="score"/>
                            </div>
                            <div class="mt8">
                                <field name="status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    
    <record id="hr_performance_review_action_kanban" model="ir.actions.act_window">
        <field name="name">Performance Reviews</field>
        <field name="res_model">hr.performance.review</field>
        <field name="view_mode">kanban,form</field>
    </record>


</odoo>
